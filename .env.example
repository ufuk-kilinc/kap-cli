# All KAP API operations use Production. The Test settings remain documented but cannot be selected.
KAP_ACTIVE_ENV=production

# Test (preprod) — token TTL ~104 days
KAP_TEST_BASE_URL=https://vykapipreprod.mkk.com.tr
KAP_TEST_API_KEY=

# Production — token TTL 24h
KAP_PROD_BASE_URL=https://kapdatafeed.kap.org.tr
KAP_PROD_API_KEY=

# Re-mint the token this many seconds before its exp (default 60)
KAP_TOKEN_REFRESH_SKEW_SECONDS=60
